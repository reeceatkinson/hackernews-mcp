{
  "name": "hackernews-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Remote MCP server for the official Hacker News API, hosted on Cloudflare Workers.",
  "type": "module",
  "scripts": {
    "start": "wrangler dev",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
